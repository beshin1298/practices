# Copy to .env (never commit .env).
#
# Demo stack (default): nothing is required. The "dev" profile supplies throwaway values, which are
# public because they live in the repository.
#
# Real deployment: leave the dev profile and give every secret. The app refuses to start without them.
# SPRING_PROFILES_ACTIVE=
# JWT_SECRET=<openssl rand -base64 32>
# DB_PASSWORD=<strong password>
# COOKIE_SECURE=true          # default outside the dev profile; needs HTTPS
# SEED_ENABLED=false          # default outside the dev profile
# SWAGGER_ENABLED=false       # default outside the dev profile
